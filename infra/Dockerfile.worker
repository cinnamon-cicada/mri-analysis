# FastSurfer worker image — runs on GPU-enabled Cloud Run Job (T4/L4).
# Base: FastSurfer with GPU support + our pipeline code on top.
FROM deepmi/fastsurfer:latest

USER root

RUN apt-get update && apt-get install -y python3-pip && rm -rf /var/lib/apt/lists/*

# FSL's `flirt` binary — required by pydeface (see backend/deface.py) for the
# registration step that removes facial geometry before FastSurfer runs.
# NeuroDebian ships a minimal `fsl-core` package; FSL's own installer script
# is a multi-GB download instead. This step depends on neuro.debian.net and a
# keyserver being reachable at build time and is a known slower/flakier layer
# than the rest of this image.
RUN apt-get update && apt-get install -y --no-install-recommends wget gnupg lsb-release ca-certificates && \
    wget -qO- http://neuro.debian.net/lists/$(lsb_release -cs).us-ca.full | tee /etc/apt/sources.list.d/neurodebian.sources.list && \
    apt-key adv --recv-keys --keyserver hkp://keyserver.ubuntu.com:80 0xA5D32F012649A5A9 && \
    apt-get update && apt-get install -y --no-install-recommends fsl-core && \
    rm -rf /var/lib/apt/lists/*
ENV FSLDIR=/usr/share/fsl/5.0
ENV PATH="${FSLDIR}/bin:${PATH}"
ENV FSLOUTPUTTYPE=NIFTI_GZ

WORKDIR /app

COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt

COPY backend/ ./backend/

WORKDIR /app/backend

ENV STORAGE_BACKEND=firebase
ENV FASTSURFER_OUTPUT_DIR=/tmp/fastsurfer_output
# Run FastSurfer in-process (run_fastsurfer.sh), not via nested `docker run` —
# Cloud Run Jobs have no Docker daemon. See utils.run_fastsurfer().
ENV FASTSURFER_MODE=native
# FREESURFER_LICENSE is supplied at runtime as a mounted secret file path
# (see infra/cloudrun_worker.yaml); FS_LICENSE is derived from it in utils.py.

# The deepmi/fastsurfer base image sets ENTRYPOINT to run_fastsurfer.sh; reset
# it so CMD runs our worker script rather than being passed as FastSurfer args.
ENTRYPOINT []

# Entrypoint: plain script, no HTTP server. JOB_ID/FILE_REF are supplied as
# per-execution container env var overrides by the dispatcher (see
# dispatcher.py), which starts this via the Cloud Run Admin API.
CMD ["python3", "worker_entrypoint.py"]
